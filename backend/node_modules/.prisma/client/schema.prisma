generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String                   @id @default(cuid())
  email                           String                   @unique
  passwordHash                    String
  firstName                       String
  lastName                        String
  avatarUrl                       String?
  status                          UserStatus               @default(ACTIVE)
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt
  announcementsCreated            Announcement[]           @relation("AnnouncementCreatedBy")
  announcementsUpdated            Announcement[]           @relation("AnnouncementUpdatedBy")
  announcementAttachmentsUploaded AnnouncementAttachment[] @relation("AnnouncementAttachmentUploadedBy")
  announcementReads               AnnouncementRead[]       @relation("AnnouncementReadBy")
  Asset_Asset_assignedByToUser    Asset[]                  @relation("Asset_assignedByToUser")
  createdAssets                   Asset[]                  @relation("AssetCreatedBy")
  assetAssignmentsBy              AssetAssignment[]        @relation("AssetAssignmentBy")
  assetAuditLogsChangedBy         AssetAuditLog[]          @relation("AssetAuditLogChangedBy")
  assetDisposalsApprovedBy        AssetDisposal[]          @relation("AssetDisposalApprovedBy")
  assetHistoryPerformedBy         AssetHistory[]           @relation("AssetHistoryPerformedBy")
  managedDepartments              Department[]             @relation("DepartmentManager")
  documentAuditLogs               DocumentAuditLog[]       @relation("DocumentAuditActor")
  documentRequestsApproved        DocumentRequest[]        @relation("DocumentRequestApprovedBy")
  documentRequestsRejected        DocumentRequest[]        @relation("DocumentRequestRejectedBy")
  documentRequestsCreated         DocumentRequest[]        @relation("DocumentRequestBy")
  documentSettingsCreated         DocumentSettings[]       @relation("DocumentSettingsCreatedBy")
  documentSettingsUpdated         DocumentSettings[]       @relation("DocumentSettingsUpdatedBy")
  documentTemplatesCreated        DocumentTemplate[]       @relation("DocumentTemplateCreatedBy")
  documentTemplatesUpdated        DocumentTemplate[]       @relation("DocumentTemplateUpdatedBy")
  employee                        Employee?
  generatedDocumentsCreated       GeneratedDocument[]      @relation("GeneratedDocumentBy")
  tasksCompleted                  Task[]                   @relation("TaskCompletedBy")
  tasksCreated                    Task[]                   @relation("TaskCreatedBy")
  tasksUpdated                    Task[]                   @relation("TaskUpdatedBy")
  taskActivities                  TaskActivity[]           @relation("TaskActivityActor")
  taskAssignmentsCreated          TaskAssignment[]         @relation("TaskAssignedBy")
  taskAttachmentsUploaded         TaskAttachment[]         @relation("TaskAttachmentUploadedBy")
  taskCommentsCreated             TaskComment[]            @relation("TaskCommentCreatedBy")
  taskTimeLogsLogged              TaskTimeLog[]            @relation("TaskTimeLogLoggedBy")
  taskWatchers                    TaskWatcher[]            @relation("TaskWatchers")
  approvedTimesheets              Timesheet[]              @relation("TimesheetApprover")
  notifications                   Notification[]
  notificationPreference          NotificationPreference?
  userRoles                       UserRole[]
  leadsCreated                    Lead[]                   @relation("LeadCreatedBy")
  leadsAssigned                   Lead[]                   @relation("LeadAssignedTo")
  leadNotes                       LeadNote[]               @relation("LeadNoteAuthor")
  leadHistories                   LeadHistory[]            @relation("LeadHistoryActor")
  leadImportJobs                  LeadImportJob[]          @relation("LeadImportJobUploader")
  leadDispositions                LeadDisposition[]        @relation("LeadDispositionActor")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime?        @default(now())
  description String?
  updatedAt   DateTime?        @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  module      String
  action      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  managerId String?
  assets    Asset[]
  manager   User?      @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[]
  expenses  Expense[]
  leads     Lead[]
}

model Employee {
  id                               String              @id @default(cuid())
  employeeCode                     String              @unique
  firstName                        String
  lastName                         String
  email                            String              @unique
  phone                            String?
  address                          String?
  emergencyContact                 String?
  designation                      String?
  status                           EmpStatus           @default(ACTIVE)
  joiningDate                      DateTime?
  salary                           Decimal?            @db.Decimal(12, 2)
  departmentId                     String?
  managerId                        String?
  userId                           String?             @unique
  createdAt                        DateTime            @default(now())
  updatedAt                        DateTime            @updatedAt
  dateOfBirth                      DateTime?           @db.Date
  employmentType                   String?
  document                         String?
  avatarUrl                        String?
  educationLevel                   String?
  educationOther                   String?
  educationField                   String?
  gender                           String?
  marriageStatus                   String?
  salaryGradeId                    String?
  salaryStepId                     String?
  lastIncrementDate                DateTime?
  advances                         Advance[]
  assignedAssets                   Asset[]             @relation("AssetAssignment")
  Asset_Asset_assignedToToEmployee Asset[]             @relation("Asset_assignedToToEmployee")
  assetAssignments                 AssetAssignment[]
  assetHistoryFrom                 AssetHistory[]      @relation("AssetHistoryFrom")
  assetHistoryTo                   AssetHistory[]      @relation("AssetHistoryTo")
  assetMaintenance                 AssetMaintenance[]
  attendanceRecords                Attendance[]
  documentRequests                 DocumentRequest[]   @relation("DocumentRequestEmployee")
  department                       Department?         @relation(fields: [departmentId], references: [id])
  manager                          Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  reports                          Employee[]          @relation("EmployeeManager")
  user                             User?               @relation(fields: [userId], references: [id])
  employeeAllowances               EmployeeAllowance[]
  expensesApproved                 Expense[]           @relation("ExpenseApprovedBy")
  expensesPaid                     Expense[]           @relation("ExpensePaidBy")
  expensesSubmitted                Expense[]           @relation("ExpenseSubmittedBy")
  expenseApprovals                 ExpenseApproval[]   @relation("ExpenseApprovalApprover")
  expensePayments                  ExpensePayment[]    @relation("ExpensePaymentPaidBy")
  generatedDocuments               GeneratedDocument[] @relation("GeneratedDocumentEmployee")
  leaveBalances                    LeaveBalance[]
  approvedLeaves                   LeaveRequest[]      @relation("ApproverLeaves")
  leaveRequests                    LeaveRequest[]      @relation("EmployeeLeaves")
  loans                            Loan[]
  payrollRecords                   Payroll[]
  payrollItems                     PayrollItem[]
  salaryIncrements                 SalaryIncrement[]
  taskAssignments                  TaskAssignment[]
  taskTimeLogs                     TaskTimeLog[]
  timesheets                       Timesheet[]

  @@index([departmentId])
  @@index([joiningDate])
  @@index([lastName, firstName])
  @@index([salaryGradeId])
}

model SalaryGrade {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  minSalary   Decimal      @db.Decimal(12, 2)
  maxSalary   Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  steps       SalaryStep[]
}

model SalaryStep {
  id        String      @id @default(cuid())
  gradeId   String
  step      Int         @map("step")
  salary    Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  grade     SalaryGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, step])
  @@index([gradeId])
}

model SalaryIncrement {
  id                  String    @id @default(cuid())
  employeeId          String
  previousSalary      Decimal   @db.Decimal(12, 2)
  newSalary           Decimal   @db.Decimal(12, 2)
  incrementAmount     Decimal   @db.Decimal(12, 2)
  incrementPercentage Decimal   @db.Decimal(5, 2)
  effectiveDate       DateTime  @db.Date
  reason              String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  employee            Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([effectiveDate])
}

model PayrollRun {
  id               String             @id @default(cuid())
  periodType       PayrollPeriodType  @default(MONTHLY)
  periodStart      DateTime           @db.Date
  periodEnd        DateTime           @db.Date
  paymentDate      DateTime?          @db.Date
  status           PayrollStatus      @default(DRAFT)
  totalGross       Decimal            @default(0) @db.Decimal(12, 2)
  totalDeductions  Decimal            @default(0) @db.Decimal(12, 2)
  totalNet         Decimal            @default(0) @db.Decimal(12, 2)
  employeeCount    Int                @default(0)
  reviewedBy       String?
  reviewedAt       DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  processedBy      String?
  processedAt      DateTime?
  comments         String?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  AdvanceRepayment AdvanceRepayment[]
  LoanRepayment    LoanRepayment[]
  auditLogs        PayrollAuditLog[]
  items            PayrollItem[]

  @@unique([periodType, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@index([paymentDate])
}

model PayrollItem {
  id                String     @id @default(cuid())
  payrollRunId      String
  employeeId        String
  basicSalary       Decimal    @db.Decimal(12, 2)
  allowances        Decimal    @default(0) @db.Decimal(12, 2)
  overtime          Decimal    @default(0) @db.Decimal(12, 2)
  bonus             Decimal    @default(0) @db.Decimal(12, 2)
  grossSalary       Decimal    @db.Decimal(12, 2)
  incomeTax         Decimal    @default(0) @db.Decimal(12, 2)
  pension           Decimal    @default(0) @db.Decimal(12, 2)
  healthInsurance   Decimal    @default(0) @db.Decimal(12, 2)
  providentFund     Decimal    @default(0) @db.Decimal(12, 2)
  loanDeductions    Decimal    @default(0) @db.Decimal(12, 2)
  advanceDeductions Decimal    @default(0) @db.Decimal(12, 2)
  absenceDeductions Decimal    @default(0) @db.Decimal(12, 2)
  otherDeductions   Decimal    @default(0) @db.Decimal(12, 2)
  totalDeductions   Decimal    @db.Decimal(12, 2)
  netSalary         Decimal    @db.Decimal(12, 2)
  workingDays       Int        @default(0)
  presentDays       Int        @default(0)
  absentDays        Int        @default(0)
  leaveDays         Int        @default(0)
  payslipGenerated  Boolean    @default(false)
  payslipUrl        String?
  generatedAt       DateTime?
  bankAccountNumber String?
  bankName          String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  employee          Employee   @relation(fields: [employeeId], references: [id])
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@index([grossSalary])
  @@index([netSalary])
}

model Allowance {
  id                 String              @id @default(cuid())
  name               String              @unique
  type               AllowanceType
  description        String?
  amount             Decimal             @db.Decimal(12, 2)
  isPercentage       Boolean             @default(false)
  percentage         Decimal?            @db.Decimal(5, 2)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  employeeAllowances EmployeeAllowance[]

  @@index([type])
  @@index([isActive])
}

model EmployeeAllowance {
  id          String    @id @default(cuid())
  employeeId  String
  allowanceId String
  month       String
  amount      Decimal   @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  allowance   Allowance @relation(fields: [allowanceId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, allowanceId, month])
  @@index([employeeId])
  @@index([month])
}

model Deduction {
  id           String        @id @default(cuid())
  name         String        @unique
  type         DeductionType
  description  String?
  amount       Decimal?      @db.Decimal(12, 2)
  isPercentage Boolean       @default(false)
  percentage   Decimal?      @db.Decimal(5, 2)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([type])
  @@index([isActive])
}

model Loan {
  id               String          @id @default(cuid())
  employeeId       String
  loanAmount       Decimal         @db.Decimal(12, 2)
  interestRate     Decimal         @default(0) @db.Decimal(5, 2)
  totalAmount      Decimal         @db.Decimal(12, 2)
  remainingAmount  Decimal         @db.Decimal(12, 2)
  monthlyPayment   Decimal         @db.Decimal(12, 2)
  startDate        DateTime        @db.Date
  endDate          DateTime?       @db.Date
  status           LoanStatus      @default(PENDING)
  description      String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  employee         Employee        @relation(fields: [employeeId], references: [id])
  repaymentHistory LoanRepayment[]

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model LoanRepayment {
  id           String      @id @default(cuid())
  loanId       String
  amount       Decimal     @db.Decimal(12, 2)
  paymentDate  DateTime    @db.Date
  notes        String?
  createdAt    DateTime    @default(now())
  payrollRunId String?
  loan         Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  PayrollRun   PayrollRun? @relation(fields: [payrollRunId], references: [id])

  @@index([loanId])
  @@index([payrollRunId])
  @@index([paymentDate])
}

model Advance {
  id               String             @id @default(cuid())
  employeeId       String
  requestedAmount  Decimal            @db.Decimal(12, 2)
  approvedAmount   Decimal            @db.Decimal(12, 2)
  remainingAmount  Decimal            @db.Decimal(12, 2)
  monthlyDeduction Decimal            @db.Decimal(12, 2)
  requestDate      DateTime           @db.Date
  status           AdvanceStatus      @default(PENDING)
  description      String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  notes            String?
  employee         Employee           @relation(fields: [employeeId], references: [id])
  repaymentHistory AdvanceRepayment[]

  @@index([employeeId])
  @@index([status])
  @@index([requestDate])
}

model AdvanceRepayment {
  id           String      @id @default(cuid())
  advanceId    String
  amount       Decimal     @db.Decimal(12, 2)
  paymentDate  DateTime    @db.Date
  notes        String?
  createdAt    DateTime    @default(now())
  payrollRunId String?
  advance      Advance     @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  PayrollRun   PayrollRun? @relation(fields: [payrollRunId], references: [id])

  @@index([advanceId])
  @@index([payrollRunId])
  @@index([paymentDate])
}

model TaxRate {
  id          String   @id @default(cuid())
  year        Int
  minIncome   Decimal  @db.Decimal(12, 2)
  maxIncome   Decimal? @db.Decimal(12, 2)
  rate        Decimal  @db.Decimal(5, 2)
  fixedAmount Decimal? @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, minIncome])
  @@index([year])
  @@index([isActive])
}

model PensionRate {
  id           String   @id @default(cuid())
  year         Int      @unique
  employeeRate Decimal  @db.Decimal(5, 2)
  employerRate Decimal  @db.Decimal(5, 2)
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

model PayrollAuditLog {
  id           String      @id @default(cuid())
  action       AuditAction
  entityType   String
  entityId     String
  payrollRunId String?
  performedBy  String
  userEmail    String?
  userName     String?
  oldValue     String?
  newValue     String?
  description  String?
  createdAt    DateTime    @default(now())
  payrollRun   PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([entityType])
  @@index([payrollRunId])
  @@index([performedBy])
  @@index([createdAt])
}

model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  days            Int
  reason          String
  status          LeaveStatus @default(PENDING)
  approverId      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  approver        Employee?   @relation("ApproverLeaves", fields: [approverId], references: [id])
  employee        Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model LeaveBalance {
  id            String    @id(map: "LeaveBalance_new_pkey") @default(cuid())
  employeeId    String
  leaveType     LeaveType
  year          Int
  allocatedDays Decimal   @db.Decimal(10, 2)
  usedDays      Decimal   @default(0) @db.Decimal(10, 2)
  carriedOver   Decimal   @default(0) @db.Decimal(10, 2)
  availableDays Decimal   @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@index([year])
}

model Attendance {
  id               String           @id @default(cuid())
  employeeId       String
  date             DateTime         @db.Date
  checkInTime      DateTime?
  checkOutTime     DateTime?
  checkInLocation  String?
  checkOutLocation String?
  status           AttendanceStatus @default(PRESENT)
  workHours        Decimal?         @db.Decimal(5, 2)
  breakMinutes     Int              @default(0)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  employee         Employee         @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model Payroll {
  id              String            @id @default(cuid())
  employeeId      String
  periodType      PayrollPeriodType @default(MONTHLY)
  periodStart     DateTime          @db.Date
  periodEnd       DateTime          @db.Date
  paymentDate     DateTime?         @db.Date
  basicSalary     Decimal           @db.Decimal(12, 2)
  bonus           Decimal           @default(0) @db.Decimal(12, 2)
  grossSalary     Decimal           @db.Decimal(12, 2)
  incomeTax       Decimal           @default(0) @db.Decimal(12, 2)
  healthInsurance Decimal           @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal           @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal           @db.Decimal(12, 2)
  netSalary       Decimal           @db.Decimal(12, 2)
  status          PayrollStatus     @default(DRAFT)
  workingDays     Int               @default(0)
  presentDays     Int               @default(0)
  absentDays      Int               @default(0)
  notes           String?
  processedBy     String?
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  allowances      Decimal           @default(0) @db.Decimal(12, 2)
  leaveDays       Int               @default(0)
  overtime        Decimal           @default(0) @db.Decimal(12, 2)
  providentFund   Decimal           @default(0) @db.Decimal(12, 2)
  employee        Employee          @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@index([paymentDate])
}

model Timesheet {
  id              String             @id @default(cuid())
  employeeId      String
  date            DateTime           @db.Date
  totalHours      Decimal            @db.Decimal(5, 2)
  status          TimesheetStatus    @default(DRAFT)
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  approver        User?              @relation("TimesheetApprover", fields: [approvedBy], references: [id])
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions        TimesheetSession[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([submittedAt])
}

model TimesheetSession {
  id          String    @id @default(cuid())
  timesheetId String
  taskName    String
  projectName String
  description String?
  startTime   DateTime
  endTime     DateTime
  duration    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId])
  @@index([startTime])
  @@index([projectName])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  assets      Asset[]
}

model AssetLocation {
  id        String            @id @default(cuid())
  name      String
  address   String?
  type      AssetLocationType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt
  assets    Asset[]

  @@index([type])
}

model AssetVendor {
  id          String             @id @default(cuid())
  name        String
  contact     String?
  phone       String?
  email       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  assets      Asset[]
  maintenance AssetMaintenance[]
  expenses    Expense[]
}

model Asset {
  id                                  String                   @id @default(cuid())
  name                                String
  serialNumber                        String                   @unique
  model                               String?
  brand                               String?
  purchaseDate                        DateTime?
  purchasePrice                       Decimal?                 @db.Decimal(12, 2)
  currentValue                        Decimal?                 @db.Decimal(12, 2)
  condition                           AssetCondition
  status                              AssetStatus
  locationName                        String?                  @map("location")
  notes                               String?
  assignedTo                          String?
  assignedDate                        DateTime?
  assignedBy                          String?
  createdAt                           DateTime                 @default(now())
  updatedAt                           DateTime                 @updatedAt
  assetCode                           String                   @unique
  categoryId                          String?
  currency                            String?                  @default("USD")
  vendorId                            String?
  warrantyUntil                       DateTime?                @db.Date
  locationId                          String?
  assignedToEmployeeId                String?
  departmentId                        String?
  depreciationMethod                  AssetDepreciationMethod?
  depreciationRate                    Decimal?                 @db.Decimal(5, 2)
  lifeYears                           Decimal?                 @db.Decimal(5, 2)
  createdBy                           String?
  User_Asset_assignedByToUser         User?                    @relation("Asset_assignedByToUser", fields: [assignedBy], references: [id])
  assignedEmployee                    Employee?                @relation("AssetAssignment", fields: [assignedToEmployeeId], references: [id])
  Employee_Asset_assignedToToEmployee Employee?                @relation("Asset_assignedToToEmployee", fields: [assignedTo], references: [id])
  category                            AssetCategory?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser                       User?                    @relation("AssetCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  department                          Department?              @relation(fields: [departmentId], references: [id])
  assetLocation                       AssetLocation?           @relation(fields: [locationId], references: [id])
  vendor                              AssetVendor?             @relation(fields: [vendorId], references: [id])
  assignments                         AssetAssignment[]
  auditLogs                           AssetAuditLog[]
  depreciation                        AssetDepreciation[]
  disposals                           AssetDisposal[]
  history                             AssetHistory[]
  maintenance                         AssetMaintenance[]
  expenses                            Expense[]

  @@index([categoryId])
  @@index([status])
  @@index([condition])
  @@index([assignedToEmployeeId])
  @@index([departmentId])
  @@index([locationId])
  @@index([vendorId])
  @@index([assetCode])
  @@index([serialNumber])
  @@index([createdBy])
  @@index([assignedTo])
}

model AssetAssignment {
  id             String    @id @default(cuid())
  assetId        String
  employeeId     String
  assignedAt     DateTime  @default(now())
  assignedBy     String
  returnedAt     DateTime?
  note           String?
  createdAt      DateTime  @default(now())
