# =============================================================================
# HRMS Backend – Environment variables (single source of truth)
# =============================================================================
# Copy this file to .env in the same directory (backend/.env) and fill in values.
# The app and Prisma load only backend/.env when run from the backend directory.
# =============================================================================

NODE_ENV=development
PORT=4000

# Database (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# Redis (optional; used for queues/notifications)
REDIS_URL="redis://localhost:6378"

# JWT
JWT_ACCESS_SECRET=change_me_long_random_string
JWT_REFRESH_SECRET=change_me_also_long_random_string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14

# URLs (for CORS, redirects, links in emails)
# CORS_ORIGIN: one origin or comma-separated (e.g. when using frontend via network IP)
CORS_ORIGIN=http://localhost:8080,http://192.168.1.2:8080
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:8080,http://192.168.1.2:8080

# Behind reverse proxy (Nginx on VPS)
TRUST_PROXY=1

# Chapa payment gateway
CHAPA_SECRET_KEY=CHASECK-xxxx

# Halal certification: blank agreement PDF (URL or path under APP) copied onto each application at submit when unset
# Example: https://example.org/halal-certification-agreement.pdf or /uploads/halal/halal-agreement-template.pdf
HALAL_AGREEMENT_TEMPLATE_URL=

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Your App Name

# Smsethiopia – SMS notifications (Halal, Membership)
SMS_ETHIOPIA_API_KEY=your-api-key
SMS_ETHIOPIA_BASE_URL=https://smsethiopia.et/api

# Seed (optional, for prisma:seed)
# ADMIN_EMAIL=admin@oriasc.org
# ADMIN_PASSWORD=Admin@12345
