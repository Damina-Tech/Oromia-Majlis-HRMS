enum HalalApplicationStatus {
  DRAFT
  SUBMITTED
  REVIEW
  /// Certification fee paid; owner must link at least two issued Halal competency certificates before the business certificate is generated.
  PENDING_COMPETENCY_LINK
  INSPECTION
  APPROVED
  REJECTED
}

enum HalalCertificateStatus {
  VALID
  EXPIRED
  REVOKED
  SUSPENDED
}

enum HalalPaymentMethod {
  CHAPA
  MANUAL
}

enum HalalPaymentStatus {
  PENDING
