  refreshedAt DateTime @default(now())
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([periodStart, periodEnd])
}

model Expense {
  id                  String            @id @default(cuid())
  referenceNo         String            @unique
  title               String
  description         String?
  amount              Decimal           @db.Decimal(12, 2)
  currency            String            @default("ETB")
  expenseType         ExpenseType
  status              ExpenseStatus     @default(DRAFT)
  incurredDate        DateTime          @db.Date
  submittedBy         String
  departmentId        String
  assetId             String?
  vendorId            String?
  paymentMethod       PaymentMethod?
  receiptUrl          String?
  approvedBy          String?
  approvedAt          DateTime?
  paidBy              String?
  paidAt              DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  approvedByEmployee  Employee?         @relation("ExpenseApprovedBy", fields: [approvedBy], references: [id])
  asset               Asset?            @relation(fields: [assetId], references: [id])
  department          Department        @relation(fields: [departmentId], references: [id])
  paidByEmployee      Employee?         @relation("ExpensePaidBy", fields: [paidBy], references: [id])
  submittedByEmployee Employee          @relation("ExpenseSubmittedBy", fields: [submittedBy], references: [id])
  vendor              AssetVendor?      @relation(fields: [vendorId], references: [id])
  approvals           ExpenseApproval[]
  payments            ExpensePayment[]

  @@index([submittedBy])
  @@index([departmentId])
  @@index([status])
  @@index([expenseType])
  @@index([incurredDate])
  @@index([createdAt])
}

model ExpenseApproval {
  id         String                @id @default(cuid())
  expenseId  String
  approverId String
  action     ExpenseApprovalAction
  comment    String?
  createdAt  DateTime              @default(now())
  approver   Employee              @relation("ExpenseApprovalApprover", fields: [approverId], references: [id])
  expense    Expense               @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([approverId])
  @@index([createdAt])
}

model ExpensePayment {
  id               String        @id @default(cuid())
  expenseId        String
  paidAmount       Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentReference String?
  paidBy           String
  paidAt           DateTime      @default(now())
  notes            String?
  expense          Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  paidByEmployee   Employee      @relation("ExpensePaymentPaidBy", fields: [paidBy], references: [id])

  @@index([expenseId])
  @@index([paidBy])
  @@index([paidAt])
}

