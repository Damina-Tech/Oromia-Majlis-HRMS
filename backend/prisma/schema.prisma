generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmpStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum LeaveType {
  CASUAL
  SICK
  VACATION
  MATERNITY
  PERSONAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum PayrollStatus {
  DRAFT
  REVIEW
  APPROVED
  PROCESSED
  PAID
  CANCELLED
}

enum PayrollPeriodType {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum AllowanceType {
  TRANSPORT
  HOUSING
  MEAL
  COMMUNICATION
  MEDICAL
  OTHER
}

enum DeductionType {
  LOAN
  ADVANCE
  PENALTY
  OTHER
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REPAID
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  PROCESS
  EXPORT
  GENERATE
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus  @default(ACTIVE)
  userRoles    UserRole[]
  employee     Employee?
  managedDepartments Department[] @relation("DepartmentManager")
  approvedTimesheets Timesheet[] @relation("TimesheetApprover")
  assignedAssetsBy Asset[] @relation("AssetAssignedBy")
  assetHistoryPerformedBy AssetHistory[] @relation("AssetHistoryPerformedBy")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // ADMIN, HR, MANAGER, EMPLOYEE
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime?        @default(now())
  updatedAt   DateTime?        @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique // e.g., "employees.read", "employees.write"
  description String?
  module      String           // e.g., "employees", "attendance", "leave"
  action      String           // e.g., "read", "write", "delete", "approve"
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  
  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  managerId String?    // Department manager (User ID)
  manager   User?       @relation("DepartmentManager", fields: [managerId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model Employee {
  id               String       @id @default(cuid())
  employeeCode     String       @unique // e.g. EMP-000123 (human ID)
  firstName        String
  lastName         String
  email            String       @unique
  phone            String?
  dateOfBirth      DateTime?    @db.Date
  gender           String?       // MALE, FEMALE, OTHER
  address          String?
  emergencyContact String?
  designation      String?
  employmentType   String?       // e.g., "FULL_TIME", "PART_TIME", "CONTRACT", "INTERN"
  educationLevel   String?       // GRADE_8, GRADE_10, GRADE_12, DEGREE, MASTER, PHD, OTHER
  educationOther   String?       // Custom education level if "OTHER" is selected
  marriageStatus   String?       // SINGLE, MARRIED, DIVORCED, WIDOWED
  document         String?       // URL or path to document file
  status           EmpStatus    @default(ACTIVE)
  joiningDate      DateTime?
  salary           Decimal?     @db.Decimal(12, 2)
  
  // Salary Grade & Step
  salaryGradeId    String?
  salaryGrade      SalaryGrade? @relation(fields: [salaryGradeId], references: [id])
  salaryStepId     String?
  salaryStep       SalaryStep?  @relation(fields: [salaryStepId], references: [id])
  lastIncrementDate DateTime?
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  managerId String? // Employee's manager (optional)
  manager   Employee? @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[] @relation("EmployeeManager")

  userId    String?  @unique // link to auth user (optional)
  user      User?    @relation(fields: [userId], references: [id])
  
  leaveRequests    LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves   LeaveRequest[] @relation("ApproverLeaves")
  leaveBalances    LeaveBalance[]
  attendanceRecords Attendance[]
  payrollRecords   Payroll[]
  payrollItems    PayrollItem[]
  timesheets       Timesheet[]
  assignedAssets   Asset[] @relation("AssetAssignment")
  assetHistoryFrom AssetHistory[] @relation("AssetHistoryFrom")
  assetHistoryTo   AssetHistory[] @relation("AssetHistoryTo")
  loans            Loan[]
  advances         Advance[]
  salaryIncrements SalaryIncrement[]
  employeeAllowances EmployeeAllowance[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([joiningDate])
  @@index([lastName, firstName])
  @@index([salaryGradeId])
  @@index([salaryStepId])
}

// Salary Grade System
model SalaryGrade {
  id          String        @id @default(cuid())
  name        String        @unique // e.g., "Grade 1", "Grade 2"
  code        String        @unique // e.g., "G1", "G2"
  description String?
  minSalary   Decimal       @db.Decimal(12, 2)
  maxSalary   Decimal       @db.Decimal(12, 2)
  steps       SalaryStep[]
  employees   Employee[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([code])
}

model SalaryStep {
  id          String        @id @default(cuid())
  gradeId     String
  grade       SalaryGrade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  step        Int           @map("step") // e.g., 1, 2, 3 within the grade
  salary      Decimal       @db.Decimal(12, 2)
  employees   Employee[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  @@unique([gradeId, step])
  @@index([gradeId])
}

// Salary Increment History
model SalaryIncrement {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  previousSalary Decimal @db.Decimal(12, 2)
  newSalary   Decimal   @db.Decimal(12, 2)
  incrementAmount Decimal @db.Decimal(12, 2)
  incrementPercentage Decimal @db.Decimal(5, 2)
  incrementDate DateTime @db.Date
  reason      String?
  approvedBy  String?   // User ID
  notes       String?
  createdAt   DateTime  @default(now())
  
  @@index([employeeId])
  @@index([incrementDate])
}

// Payroll Run (monthly/biweekly cycle)
model PayrollRun {
  id          String            @id @default(cuid())
  periodType  PayrollPeriodType @default(MONTHLY)
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  paymentDate DateTime?         @db.Date
  
  status      PayrollStatus     @default(DRAFT)
  
  // Totals
  totalGross  Decimal           @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(15, 2)
  totalNet    Decimal           @default(0) @db.Decimal(15, 2)
  employeeCount Int            @default(0)
  
  // Approval workflow
  reviewedBy  String?           // User ID
  reviewedAt  DateTime?
  approvedBy  String?           // User ID
  approvedAt  DateTime?
  processedBy String?           // User ID
  processedAt DateTime?
  
  comments    String?
  notes       String?
  
  // Relations
  items       PayrollItem[]
  auditLogs   PayrollAuditLog[]
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  @@unique([periodType, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@index([paymentDate])
}

// Individual Payroll Item (per employee in a run)
model PayrollItem {
  id          String        @id @default(cuid())
  payrollRunId String
  payrollRun  PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  
  // Earnings
  basicSalary    Decimal    @db.Decimal(12, 2)
  allowances     Decimal    @default(0) @db.Decimal(12, 2)
  overtime       Decimal    @default(0) @db.Decimal(12, 2)
  bonus          Decimal    @default(0) @db.Decimal(12, 2)
  grossSalary    Decimal    @db.Decimal(12, 2)
  
  // Deductions
  incomeTax      Decimal    @default(0) @db.Decimal(12, 2)
  pension        Decimal    @default(0) @db.Decimal(12, 2)
  healthInsurance Decimal   @default(0) @db.Decimal(12, 2)
  providentFund  Decimal    @default(0) @db.Decimal(12, 2)
  loanDeductions Decimal    @default(0) @db.Decimal(12, 2) // Total from all active loans
  advanceDeductions Decimal @default(0) @db.Decimal(12, 2) // Total from all advances
  absenceDeductions Decimal @default(0) @db.Decimal(12, 2) // Deductions for absences
  otherDeductions Decimal   @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal   @db.Decimal(12, 2)
  
  // Net Salary
  netSalary      Decimal    @db.Decimal(12, 2)
  
  // Attendance Summary
  workingDays    Int        @default(0)
  presentDays    Int        @default(0)
  absentDays     Int        @default(0)
  leaveDays      Int        @default(0)
  
  // Payslip generation
  payslipGenerated Boolean  @default(false)
  payslipUrl      String?
  generatedAt     DateTime?
  
  // Bank payment info
  bankAccountNumber String?
  bankName         String?
  
  notes          String?
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@index([grossSalary])
  @@index([netSalary])
}

// Allowance Configuration
model Allowance {
  id          String        @id @default(cuid())
  name        String        @unique
  type        AllowanceType
  description String?
  amount      Decimal       @db.Decimal(12, 2) // Can be fixed or used as base
  isPercentage Boolean      @default(false)
  percentage  Decimal?      @db.Decimal(5, 2) // If percentage, % of basic salary
  isActive    Boolean       @default(true)
  
  // Relations
  employeeAllowances EmployeeAllowance[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([type])
  @@index([isActive])
}

// Allowance Assignment to Employee (monthly)
model EmployeeAllowance {
  id          String      @id @default(cuid())
  employeeId String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  allowanceId String
  allowance   Allowance   @relation(fields: [allowanceId], references: [id])
  month       String      // Format: "YYYY-MM"
  amount      Decimal     @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@unique([employeeId, allowanceId, month])
  @@index([employeeId])
  @@index([month])
}

// Deduction Configuration
model Deduction {
  id          String        @id @default(cuid())
  name        String        @unique
  type        DeductionType
  description String?
  amount      Decimal?      @db.Decimal(12, 2) // If fixed amount
  isPercentage Boolean      @default(false)
  percentage  Decimal?      @db.Decimal(5, 2) // If percentage
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([type])
  @@index([isActive])
}

// Loan Management
model Loan {
  id              String      @id @default(cuid())
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id])
  
  loanAmount      Decimal      @db.Decimal(12, 2)
  interestRate    Decimal      @default(0) @db.Decimal(5, 2) // Annual interest rate %
  totalAmount     Decimal      @db.Decimal(12, 2) // Total to repay (principal + interest)
  remainingAmount Decimal      @db.Decimal(12, 2)
  monthlyPayment  Decimal      @db.Decimal(12, 2)
  
  startDate       DateTime     @db.Date
  endDate         DateTime?    @db.Date
  status          LoanStatus   @default(ACTIVE)
  
  description     String?
  approvedBy      String?      // User ID
  approvedAt      DateTime?
  
  repaymentHistory LoanRepayment[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

// Loan Repayment History
model LoanRepayment {
  id          String      @id @default(cuid())
  loanId      String
  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payrollRunId String?    // If paid via payroll
  amount      Decimal     @db.Decimal(12, 2)
  paymentDate DateTime    @db.Date
  notes       String?
  createdAt   DateTime    @default(now())
  
  @@index([loanId])
  @@index([payrollRunId])
  @@index([paymentDate])
}

// Advance Management
model Advance {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  
  requestedAmount Decimal       @db.Decimal(12, 2)
  approvedAmount Decimal       @db.Decimal(12, 2)
  remainingAmount Decimal       @db.Decimal(12, 2)
  monthlyDeduction Decimal      @db.Decimal(12, 2)
  
  requestDate     DateTime      @db.Date
  status          AdvanceStatus @default(PENDING)
  
  description     String?
  approvedBy      String?       // User ID
  approvedAt      DateTime?
  notes           String?
  
  repaymentHistory AdvanceRepayment[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([employeeId])
  @@index([status])
  @@index([requestDate])
}

// Advance Repayment History
model AdvanceRepayment {
  id          String      @id @default(cuid())
  advanceId   String
  advance     Advance     @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payrollRunId String?    // If paid via payroll
  amount      Decimal     @db.Decimal(12, 2)
  paymentDate DateTime    @db.Date
  notes       String?
  createdAt   DateTime    @default(now())
  
  @@index([advanceId])
  @@index([payrollRunId])
  @@index([paymentDate])
}

// Tax Rate Configuration
model TaxRate {
  id          String      @id @default(cuid())
  minIncome   Decimal     @db.Decimal(12, 2)
  maxIncome   Decimal?    @db.Decimal(12, 2) // null for highest bracket
  rate        Decimal     @db.Decimal(5, 2) // Percentage
  fixedAmount Decimal?    @db.Decimal(12, 2) // Fixed tax amount for this bracket
  year        Int         // Tax year
  isActive    Boolean     @default(true)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@unique([year, minIncome])
  @@index([year])
  @@index([isActive])
}

// Pension Rate Configuration
model PensionRate {
  id          String      @id @default(cuid())
  employeeRate Decimal    @db.Decimal(5, 2) // Employee contribution %
  employerRate Decimal    @db.Decimal(5, 2) // Employer contribution %
  year        Int         // Year this rate applies
  isActive    Boolean     @default(true)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@unique([year])
  @@index([isActive])
}

// Payroll Audit Log
model PayrollAuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String      // e.g., "PayrollRun", "Loan", "Advance"
  entityId    String      // ID of the affected entity
  payrollRunId String?    // Related payroll run if applicable
  payrollRun  PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  
  // User info
  performedBy String      // User ID
  userEmail   String?
  userName    String?
  
  // Change details
  oldValue    String?     // JSON string of old state
  newValue    String?     // JSON string of new state
  description String?
  
  createdAt   DateTime    @default(now())
  
  @@index([action])
  @@index([entityType])
  @@index([payrollRunId])
  @@index([performedBy])
  @@index([createdAt])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String
  status      LeaveStatus @default(PENDING)
  
  approverId  String?
  approver    Employee?   @relation("ApproverLeaves", fields: [approverId], references: [id])
  approvedAt  DateTime?
  rejectionReason String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model LeaveBalance {
  id            String       @id @default(cuid())
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType
  year          Int          // Year for this balance (e.g., 2025)
  allocatedDays Decimal      @db.Decimal(10, 2) // Total days allocated for this leave type in this year
  usedDays      Decimal      @default(0) @db.Decimal(10, 2) // Days used
  carriedOver   Decimal      @default(0) @db.Decimal(10, 2) // Days carried over from previous year
  availableDays Decimal      @db.Decimal(10, 2) // Available = allocated - used + carriedOver
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@index([year])
}

model Attendance {
  id          String            @id @default(cuid())
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id])
  
  date        DateTime          @db.Date
  checkInTime DateTime?
  checkOutTime DateTime?
  
  checkInLocation  String?
  checkOutLocation String?
  
  status      AttendanceStatus  @default(PRESENT)
  workHours   Decimal?          @db.Decimal(5, 2)
  breakMinutes Int              @default(0)
  
  notes       String?
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model Payroll {
  id          String            @id @default(cuid())
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id])
  
  // Period Information
  periodType  PayrollPeriodType @default(MONTHLY)
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  paymentDate DateTime?         @db.Date
  
  // Earnings
  basicSalary    Decimal        @db.Decimal(12, 2)
  allowances     Decimal        @default(0) @db.Decimal(12, 2)
  overtime       Decimal        @default(0) @db.Decimal(12, 2)
  bonus          Decimal        @default(0) @db.Decimal(12, 2)
  grossSalary    Decimal        @db.Decimal(12, 2)
  
  // Deductions
  incomeTax      Decimal        @default(0) @db.Decimal(12, 2)
  healthInsurance Decimal       @default(0) @db.Decimal(12, 2)
  providentFund  Decimal        @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal       @db.Decimal(12, 2)
  
  // Net Salary
  netSalary      Decimal        @db.Decimal(12, 2)
  
  // Status and Processing
  status         PayrollStatus  @default(DRAFT)
  processedBy    String?
  processedAt    DateTime?
  
  // Additional Info
  workingDays    Int            @default(0)
  presentDays    Int            @default(0)
  absentDays     Int            @default(0)
  leaveDays      Int            @default(0)
  
  notes          String?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@index([paymentDate])
}

// Timesheet Status
enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Timesheet Entry
model Timesheet {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime        @db.Date
  totalHours  Decimal         @db.Decimal(5, 2) // Max 999.99 hours
  status      TimesheetStatus @default(DRAFT)
  submittedAt DateTime?
  approvedAt  DateTime?
  approvedBy  String? // User ID who approved
  approver    User?           @relation("TimesheetApprover", fields: [approvedBy], references: [id])
  rejectionReason String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  sessions    TimesheetSession[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([submittedAt])
}

// Timesheet Session (individual time entries)
model TimesheetSession {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  taskName    String
  projectName String
  description String?
  startTime   DateTime
  endTime     DateTime
  duration    Int       // Duration in minutes
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([timesheetId])
  @@index([startTime])
  @@index([projectName])
}

// Asset Status
enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
  LOST
  DAMAGED
}

// Asset Condition
enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

// Asset Category
enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  KEYBOARD
  MOUSE
  PHONE
  TABLET
  HEADSET
  PRINTER
  NETWORK_EQUIPMENT
  OTHER
}

// Asset Assignment History Action
enum AssetHistoryAction {
  CREATED
  ASSIGNED
  REVOKED
  TRANSFERRED
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  STATUS_CHANGED
  CONDITION_UPDATED
  RETIRED
  LOST
  FOUND
}

// Asset Management
model Asset {
  id            String        @id @default(cuid())
  name          String        // e.g., "MacBook Pro 16\""
  category      AssetCategory
  serialNumber  String        @unique // Unique serial number
  model         String?
  brand         String?
  purchaseDate  DateTime?
  purchasePrice Decimal?      @db.Decimal(12, 2)
  currentValue  Decimal?      @db.Decimal(12, 2)
  condition     AssetCondition @default(EXCELLENT)
  status        AssetStatus   @default(AVAILABLE)
  location      String?       // Office location or storage
  notes         String?
  
  // Assignment details
  assignedTo    String?       // Employee ID
  assignedDate  DateTime?
  assignedBy    String?       // User ID who assigned
  
  // Relations
  assignedEmployee Employee? @relation("AssetAssignment", fields: [assignedTo], references: [id])
  assignedByUser   User?     @relation("AssetAssignedBy", fields: [assignedBy], references: [id])
  history          AssetHistory[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
  @@index([status])
  @@index([condition])
  @@index([assignedTo])
  @@index([serialNumber])
  @@index([location])
}

// Asset Assignment History
model AssetHistory {
  id          String            @id @default(cuid())
  assetId     String
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action      AssetHistoryAction
  description String?
  
  // Assignment details
  fromEmployeeId String? // Previous employee
  toEmployeeId   String? // New employee
  fromEmployee   Employee? @relation("AssetHistoryFrom", fields: [fromEmployeeId], references: [id])
  toEmployee     Employee? @relation("AssetHistoryTo", fields: [toEmployeeId], references: [id])
  
  // Additional data
  previousStatus    AssetStatus?
  newStatus         AssetStatus?
  previousCondition AssetCondition?
  newCondition      AssetCondition?
  
  // Audit trail
  performedBy   String // User ID who performed the action
  performedByUser User @relation("AssetHistoryPerformedBy", fields: [performedBy], references: [id])
  
  createdAt     DateTime        @default(now())

  @@index([assetId])
  @@index([action])
  @@index([performedBy])
  @@index([createdAt])
}