generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmpStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum LeaveType {
  CASUAL
  SICK
  VACATION
  MATERNITY
  PERSONAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

enum PayrollPeriodType {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus  @default(ACTIVE)
  userRoles    UserRole[]
  employee     Employee?
  approvedTimesheets Timesheet[] @relation("TimesheetApprover")
  assignedAssetsBy Asset[] @relation("AssetAssignedBy")
  assetHistoryPerformedBy AssetHistory[] @relation("AssetHistoryPerformedBy")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // ADMIN, HR, MANAGER, EMPLOYEE
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime?        @default(now())
  updatedAt   DateTime?        @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique // e.g., "employees.read", "employees.write"
  description String?
  module      String           // e.g., "employees", "attendance", "leave"
  action      String           // e.g., "read", "write", "delete", "approve"
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  
  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]
}

model Employee {
  id               String       @id @default(cuid())
  employeeCode     String       @unique // e.g. EMP-000123 (human ID)
  firstName        String
  lastName         String
  email            String       @unique
  phone            String?
  address          String?
  emergencyContact String?
  designation      String?
  status           EmpStatus    @default(ACTIVE)
  joiningDate      DateTime?
  salary           Decimal?     @db.Decimal(12, 2)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  managerId String? // Employee's manager (optional)
  manager   Employee? @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[] @relation("EmployeeManager")

  userId    String?  @unique // link to auth user (optional)
  user      User?    @relation(fields: [userId], references: [id])
  
  leaveRequests    LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves   LeaveRequest[] @relation("ApproverLeaves")
  leaveBalance     LeaveBalance?
  attendanceRecords Attendance[]
  payrollRecords   Payroll[]
  timesheets       Timesheet[]
  assignedAssets   Asset[] @relation("AssetAssignment")
  assetHistoryFrom AssetHistory[] @relation("AssetHistoryFrom")
  assetHistoryTo   AssetHistory[] @relation("AssetHistoryTo")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([joiningDate])
  @@index([lastName, firstName])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String
  status      LeaveStatus @default(PENDING)
  
  approverId  String?
  approver    Employee?   @relation("ApproverLeaves", fields: [approverId], references: [id])
  approvedAt  DateTime?
  rejectionReason String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id])
  
  casualLeave    Int @default(12)
  sickLeave      Int @default(10)
  vacationLeave  Int @default(21)
  personalLeave  Int @default(5)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id          String            @id @default(cuid())
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id])
  
  date        DateTime          @db.Date
  checkInTime DateTime?
  checkOutTime DateTime?
  
  checkInLocation  String?
  checkOutLocation String?
  
  status      AttendanceStatus  @default(PRESENT)
  workHours   Decimal?          @db.Decimal(5, 2)
  breakMinutes Int              @default(0)
  
  notes       String?
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model Payroll {
  id          String            @id @default(cuid())
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id])
  
  // Period Information
  periodType  PayrollPeriodType @default(MONTHLY)
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  paymentDate DateTime?         @db.Date
  
  // Earnings
  basicSalary    Decimal        @db.Decimal(12, 2)
  allowances     Decimal        @default(0) @db.Decimal(12, 2)
  overtime       Decimal        @default(0) @db.Decimal(12, 2)
  bonus          Decimal        @default(0) @db.Decimal(12, 2)
  grossSalary    Decimal        @db.Decimal(12, 2)
  
  // Deductions
  incomeTax      Decimal        @default(0) @db.Decimal(12, 2)
  healthInsurance Decimal       @default(0) @db.Decimal(12, 2)
  providentFund  Decimal        @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal       @db.Decimal(12, 2)
  
  // Net Salary
  netSalary      Decimal        @db.Decimal(12, 2)
  
  // Status and Processing
  status         PayrollStatus  @default(DRAFT)
  processedBy    String?
  processedAt    DateTime?
  
  // Additional Info
  workingDays    Int            @default(0)
  presentDays    Int            @default(0)
  absentDays     Int            @default(0)
  leaveDays      Int            @default(0)
  
  notes          String?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@index([paymentDate])
}

// Timesheet Status
enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Timesheet Entry
model Timesheet {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime        @db.Date
  totalHours  Decimal         @db.Decimal(5, 2) // Max 999.99 hours
  status      TimesheetStatus @default(DRAFT)
  submittedAt DateTime?
  approvedAt  DateTime?
  approvedBy  String? // User ID who approved
  approver    User?           @relation("TimesheetApprover", fields: [approvedBy], references: [id])
  rejectionReason String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  sessions    TimesheetSession[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([submittedAt])
}

// Timesheet Session (individual time entries)
model TimesheetSession {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  taskName    String
  projectName String
  description String?
  startTime   DateTime
  endTime     DateTime
  duration    Int       // Duration in minutes
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([timesheetId])
  @@index([startTime])
  @@index([projectName])
}

// Asset Status
enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
  LOST
  DAMAGED
}

// Asset Condition
enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

// Asset Category
enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  KEYBOARD
  MOUSE
  PHONE
  TABLET
  HEADSET
  PRINTER
  NETWORK_EQUIPMENT
  OTHER
}

// Asset Assignment History Action
enum AssetHistoryAction {
  CREATED
  ASSIGNED
  REVOKED
  TRANSFERRED
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  STATUS_CHANGED
  CONDITION_UPDATED
  RETIRED
  LOST
  FOUND
}

// Asset Management
model Asset {
  id            String        @id @default(cuid())
  name          String        // e.g., "MacBook Pro 16\""
  category      AssetCategory
  serialNumber  String        @unique // Unique serial number
  model         String?
  brand         String?
  purchaseDate  DateTime?
  purchasePrice Decimal?      @db.Decimal(12, 2)
  currentValue  Decimal?      @db.Decimal(12, 2)
  condition     AssetCondition @default(EXCELLENT)
  status        AssetStatus   @default(AVAILABLE)
  location      String?       // Office location or storage
  notes         String?
  
  // Assignment details
  assignedTo    String?       // Employee ID
  assignedDate  DateTime?
  assignedBy    String?       // User ID who assigned
  
  // Relations
  assignedEmployee Employee? @relation("AssetAssignment", fields: [assignedTo], references: [id])
  assignedByUser   User?     @relation("AssetAssignedBy", fields: [assignedBy], references: [id])
  history          AssetHistory[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
  @@index([status])
  @@index([condition])
  @@index([assignedTo])
  @@index([serialNumber])
  @@index([location])
}

// Asset Assignment History
model AssetHistory {
  id          String            @id @default(cuid())
  assetId     String
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action      AssetHistoryAction
  description String?
  
  // Assignment details
  fromEmployeeId String? // Previous employee
  toEmployeeId   String? // New employee
  fromEmployee   Employee? @relation("AssetHistoryFrom", fields: [fromEmployeeId], references: [id])
  toEmployee     Employee? @relation("AssetHistoryTo", fields: [toEmployeeId], references: [id])
  
  // Additional data
  previousStatus    AssetStatus?
  newStatus         AssetStatus?
  previousCondition AssetCondition?
  newCondition      AssetCondition?
  
  // Audit trail
  performedBy   String // User ID who performed the action
  performedByUser User @relation("AssetHistoryPerformedBy", fields: [performedBy], references: [id])
  
  createdAt     DateTime        @default(now())

  @@index([assetId])
  @@index([action])
  @@index([performedBy])
  @@index([createdAt])
}