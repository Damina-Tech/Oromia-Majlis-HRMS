  FAILED
  REJECTED
}

enum HalalAuditAction {
  BUSINESS_REGISTERED
  BUSINESS_APPROVED
  APPLICATION_CREATED
  APPLICATION_SUBMITTED
  APPLICATION_REVIEWED
  INSPECTION_ASSIGNED
  INSPECTION_COMPLETED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  CERTIFICATE_ISSUED
  CERTIFICATE_RENEWED
  CERTIFICATE_REVOKED
  VIOLATION_RECORDED
}

model HalalBusiness {
  id            String               @id @default(cuid())
  name          String
  category      HalalBusinessCategory
  /// When category is OTHER, free-text description from the applicant
  categoryOther String?
  status        HalalBusinessStatus   @default(PENDING_APPROVAL)
  licenseUrl    String?              // Path to uploaded license
  contactName   String
  contactEmail  String
  contactPhone  String
  userId        String               // Business owner (User)
  // Extended owner info (from registration form)
  ownerNationalId  String?
  ownerGender      String?
  ownerDateOfBirth DateTime?
  ownerHomeAddress String?
  ownerRole        String?
  // Extended business info
  brandName       String?
  yearEstablished Int?
  businessType    String?
  tinNumber       String?
  /// Registration step: total area, production area, lines, shifts, employees (sq km / counts)
  productionSystem Json?
  declarationSignedAt   DateTime?
  declarationSignature  String?
  declarationChecklist  Json?                // { noAlcohol, noProhibited, majlisCompliance, dataAccurate } from registration
  productList    Json?                // [{ name, description }] from registration (slaughterhouse-focused category + method + storage)
  documents      Json?                // [{ name, url }] from registration (Health Cert, ISO 22000, TIN Cert, Owner ID/Passport)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId      String?
  region        Region?              @relation(fields: [regionId], references: [id])
  zoneId        String?
  zone          Zone?               @relation(fields: [zoneId], references: [id])
  woredaId      String?
  woreda        Woreda?             @relation(fields: [woredaId], references: [id])
  kebeleName    String?
  latitude      Decimal?             @db.Decimal(10, 8)
  longitude     Decimal?             @db.Decimal(11, 8)
  address       String?
  /// Multiple owners/managers (JSON array of { fullName, email, phone, nationalId?, gender?, dateOfBirth?, homeAddress?, role? })
  ownersManagers Json?
  businessPhone   String?
  businessEmail   String?
  businessWebsite String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  applications  HalalApplication[]
  halalCertificates HalalCertificate[]
  productCertificates HalalProductCertificate[]

  @@index([userId])
  @@index([category])
  @@index([regionId])
}

model HalalApplication {
  id              String                 @id @default(cuid())
  businessId      String
  business        HalalBusiness          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status          HalalApplicationStatus @default(DRAFT)
  feeAmount       Decimal?               @db.Decimal(12, 2) // Certification fee (e.g. 500 ETB)
  feePaidAt       DateTime?              // When payment was confirmed
  paymentMethod   String?                // CHAPA | MANUAL
  paymentBankName String?                // For manual: bank name
  paymentReceiptUrl String?              // For manual: receipt file URL
  chapaTxRef      String?                // Chapa transaction reference
  chapaRefId      String?                // Chapa internal reference ID
  payments        HalalPayment[]
  productList     Json?                   // [{ name, description }]
  ingredients     Json?                   // [{ name, source, halalStatus }]
  supplierInfo    Json?                   // [{ name, certification }]
  documents       Json?                   // [{ name, url, type }]
  submittedAt     DateTime?
  reviewedById    String?
  reviewer        User?                  @relation("HalalReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  approvedById    String?
  approver        User?                  @relation("HalalApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  /// Committee / certification head notes when approving (internal; not exposed to business owner via API).
  committeeNotes    String?
  /// Uploaded meeting minutes path when approving (internal; not exposed to business owner via API).
  meetingMinutesUrl String?
  /// Blank agreement PDF (or URL) for this application; may be set from HALAL_AGREEMENT_TEMPLATE_URL on submit.
  agreementTemplateUrl            String?
  /// Owner-uploaded signed/stamped agreement file path under /uploads/halal/
  agreementOwnerSignedUrl       String?
  agreementOwnerSubmittedAt     DateTime?
  /// Majlis-uploaded fully executed agreement (both parties); set together with approval timestamp.
  agreementMajlisSignedUrl        String?
  agreementMajlisApprovedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  inspections     HalalInspection[]
  certificate     HalalCertificate?
  /// At least two issued competency certificates linked by the business owner after payment, before certificate issuance.
  competencyWorkerLinks HalalApplicationCompetencyWorker[]
  auditLogs       HalalAuditLog[]

  @@index([businessId])
  @@index([status])
}

/// Links a certification application to individual Halal competency certificate holders (workers).
model HalalApplicationCompetencyWorker {
  id                      String                   @id @default(cuid())
  applicationId           String
  application             HalalApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  competencyCertificateId String
  competencyCertificate   HalalCompetencyCertificate @relation(fields: [competencyCertificateId], references: [id], onDelete: Restrict)
  createdAt               DateTime                 @default(now())

  @@unique([applicationId, competencyCertificateId])
  @@index([competencyCertificateId])
}

model HalalPayment {
  id             String            @id @default(cuid())
  applicationId  String
  application    HalalApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("ETB")
  method         HalalPaymentMethod
  status         HalalPaymentStatus @default(PENDING)
  bankName       String?
  chapaTxRef     String?
  chapaRefId     String?
  receiptUrl     String?
  paidAt         DateTime?
  processedById  String?
  processedBy    User?             @relation("HalalPaymentProcessedBy", fields: [processedById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([applicationId])
  @@index([status])
  @@index([chapaTxRef])
}

enum HalalInspectionExpertRole {
  TECHNICAL_EXPERT
  SHARIA_EXPERT
}

model HalalInspection {
  id            String         @id @default(cuid())
  applicationId String
  application   HalalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  inspectorId   String
  inspector     User           @relation("HalalInspector", fields: [inspectorId], references: [id])
  /// Technical vs Sharia expert lane for this inspection assignment.
  expertRole    HalalInspectionExpertRole @default(TECHNICAL_EXPERT)
  scheduledAt   DateTime?
  completedAt   DateTime?
  checklistData Json?          // Category-based checklist results
  evidence      Json?          // [{ url, type: "photo"|"video" }]
  gpsLat        Decimal?       @db.Decimal(10, 8)
  gpsLng        Decimal?       @db.Decimal(11, 8)
  digitalSignature String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([applicationId])
  @@index([inspectorId])
}

model HalalCertificate {
  id            String              @id @default(cuid())
  certificateId String              @unique // Auto: HAL-YYYY-NNNN
  applicationId String              @unique
  application   HalalApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  businessId    String
  business      HalalBusiness        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pdfUrl        String?
  qrCode        String?             // QR data or stored image path
  issuedAt      DateTime           @default(now())
  expiresAt     DateTime
  status        HalalCertificateStatus @default(VALID)
  revokedAt     DateTime?
  revokedReason String?
  /// Start of the current 3-year Halal certification cycle (initial issue or last full recertification).
  certificationCycleStartedAt DateTime @default(now())
  /// Annual renewals already applied in this cycle (max 2; year 3 requires full recertification).
  annualRenewalCount Int @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  renewals      HalalRenewal[]
  violations    HalalViolation[]

  @@index([certificateId])
  @@index([status])
  @@index([expiresAt])
  @@index([businessId])
  @@index([businessId, status])
  productCertificates HalalProductCertificate[]
}

enum HalalProductCertificateStatus {
  PAYMENT_PENDING
  ISSUED
  CANCELLED
}

model HalalProductCertificate {
  id                  String                        @id @default(cuid())
  /// Public id on PDF, e.g. HAL-P-2026-00001 (assigned when payment completes)
  certificateNumber   String?                       @unique
  halalCertificateId  String
  halalCertificate    HalalCertificate              @relation(fields: [halalCertificateId], references: [id], onDelete: Cascade)
  businessId          String
  business            HalalBusiness                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productName         String
  productAmount       String
  destination         String
  notes               String?
  status              HalalProductCertificateStatus @default(PAYMENT_PENDING)
  feeAmount           Decimal                       @default(3500) @db.Decimal(12, 2)
  feePaidAt           DateTime?
  paymentMethod       String?
  paymentBankName     String?
  paymentReceiptUrl   String?
  chapaTxRef          String?
  chapaRefId          String?
  pdfUrl              String?
  issuedAt            DateTime?
  manualPaymentApprovedById String?
  manualPaymentApprovedBy     User?                 @relation("HalalProductPaymentApprovedBy", fields: [manualPaymentApprovedById], references: [id])
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([businessId])
  @@index([halalCertificateId])
  @@index([status])
}

enum HalalCompetencyStatus {
  DRAFT
  SUBMITTED
  THEORETICAL_SCHEDULED
  THEORETICAL_PASSED
  THEORETICAL_FAILED
  TECHNICAL_SCHEDULED
  TECHNICAL_PASSED
  TECHNICAL_FAILED
  PAYMENT_PENDING
  ISSUED
  CANCELLED
}

enum HalalCompetencyRenewalStatus {
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
}

/// Individual Halal Competency Certificate — application, interviews, payment, and issuance on one record.
model HalalCompetencyCertificate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("HalalCompetencyApplicant", fields: [userId], references: [id], onDelete: Cascade)

  fullName     String
  dateOfBirth  DateTime? @db.Date
  phone        String?
  email        String?
  employerName String
  jobTitle     String?
  /// Structured self-declarations (prayer, fasting, slaughter knowledge, etc.) as JSON
  religiousAnswers   Json
  supportLetterUrl   String?

  status HalalCompetencyStatus @default(DRAFT)

  theoreticalScheduledAt    DateTime?
  theoreticalNotes          String?
  theoreticalPassed         Boolean?
  theoreticalRecordedAt     DateTime?
  theoreticalRecordedById   String?
  theoreticalRecordedBy     User?   @relation("HalalCompetencyTheoryBy", fields: [theoreticalRecordedById], references: [id])

  technicalScheduledAt    DateTime?
  technicalNotes          String?
  technicalPassed         Boolean?
  technicalRecordedAt     DateTime?
  technicalRecordedById   String?
  technicalRecordedBy     User?   @relation("HalalCompetencyTechBy", fields: [technicalRecordedById], references: [id])

  feeAmount Decimal @default(1000) @db.Decimal(12, 2)
  feePaidAt DateTime?
  paymentMethod String?
  paymentBankName String?
  paymentReceiptUrl String?
  chapaTxRef String?
  chapaRefId String?
  manualPaymentApprovedById String?
  manualPaymentApprovedBy   User? @relation("HalalCompetencyManualBy", fields: [manualPaymentApprovedById], references: [id])

  certificateNumber String? @unique
  pdfUrl            String?
  issuedAt          DateTime?
  expiresAt         DateTime?

  renewals HalalCompetencyRenewal[]
  applicationLinks HalalApplicationCompetencyWorker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([certificateNumber])
}

model HalalCompetencyRenewal {
  id             String                   @id @default(cuid())
  competencyId   String
  competency     HalalCompetencyCertificate @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  status    HalalCompetencyRenewalStatus @default(PAYMENT_PENDING)
  feeAmount Decimal                      @default(1000) @db.Decimal(12, 2)
  feePaidAt DateTime?
  paymentMethod       String?
  paymentBankName     String?
  paymentReceiptUrl   String?
  chapaTxRef          String?
  chapaRefId          String?
  manualPaymentApprovedById String?
  manualPaymentApprovedBy   User? @relation("HalalCompetencyRenewalManualBy", fields: [manualPaymentApprovedById], references: [id])

  previousExpiry DateTime
  newExpiry      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competencyId])
  @@index([status])
}

model HalalRenewal {
  id            String         @id @default(cuid())
  certificateId String
  certificate   HalalCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  renewedAt     DateTime       @default(now())
  previousExpiry DateTime
  newExpiry     DateTime
  status        String         // PENDING, APPROVED, REJECTED
  /// ANNUAL = one-year extension within the 3-year cycle; FULL_RECERTIFICATION = recorded when a new cycle starts (optional audit).
  renewalKind   String         @default("ANNUAL")
  createdAt     DateTime       @default(now())

  @@index([certificateId])
}

model HalalViolation {
  id            String           @id @default(cuid())
  certificateId String
  certificate   HalalCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  description   String
  severity      String           // MINOR, MAJOR, CRITICAL
  recordedAt    DateTime         @default(now())
  resolvedAt    DateTime?
  action        String?          // WARNING, SUSPENSION, REVOCATION

  @@index([certificateId])
}

model HalalAuditLog {
  id            String         @id @default(cuid())
  action        HalalAuditAction
  actorId       String
  actor         User           @relation(fields: [actorId], references: [id])
  entityType    String         // Business, Application, Inspection, Certificate
  entityId      String?
  applicationId String?
  application   HalalApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  oldValue     Json?
  newValue     Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  @@index([actorId])
  @@index([applicationId])
  @@index([action])
  @@index([createdAt])
}

// ========== Majlis Online Membership ==========
enum MembershipPlanType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MemberCategory {
  REGULAR_MEMBER
  BUSINESS_OWNER
  YOUTH_WOMEN_COUNCIL
  FARMER
  ELDER_MOTHER
}

enum MembershipSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

enum MembershipPaymentMethod {
  CHAPA
  MANUAL
  CASH
}

enum MembershipPaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model MembershipPlan {
  id              String               @id @default(cuid())
  name            String
  planType        MembershipPlanType    @unique
  feeAmount       Decimal               @db.Decimal(10, 2)
  durationMonths  Int
  isActive        Boolean               @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  subscriptions   MembershipSubscription[]

  @@index([isActive])
}

model Member {
  id               String                    @id @default(cuid())
  fullName         String
  phone            String                    @unique
  email            String?
  dateOfBirth      DateTime?
  gender           String?
  regionId         String?
  region           Region?                   @relation(fields: [regionId], references: [id])
  zoneId           String?
  zone             Zone?                     @relation(fields: [zoneId], references: [id])
  woredaId         String?
  woreda           Woreda?                   @relation(fields: [woredaId], references: [id])
  addressLine      String?
  profilePhotoUrl  String?
  nationalId       String?
  category         MemberCategory
  categoryData     Json?                     // Category-specific fields
  userId           String?                   @unique
  user             User?                     @relation("MemberProfile", fields: [userId], references: [id], onDelete: SetNull)
  registeredById   String?
  registeredBy     User?                     @relation("MemberRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  subscriptions    MembershipSubscription[]
  certificates     MembershipCertificate[]

  @@index([phone])
  @@index([category])
  @@index([userId])
  @@index([registeredById])
}

model MembershipSubscription {
  id             String                       @id @default(cuid())
  memberId       String
  member         Member                       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId         String
  plan           MembershipPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status         MembershipSubscriptionStatus @default(PENDING_PAYMENT)
  startDate      DateTime?
  endDate        DateTime?
  chapaTxRef     String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  payments       MembershipPayment[]
  certificate    MembershipCertificate?

  @@index([memberId])
  @@index([planId])
  @@index([status])
  @@index([chapaTxRef])
}

model MembershipPayment {
  id              String                    @id @default(cuid())
  subscriptionId  String
  subscription    MembershipSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount          Decimal                   @db.Decimal(10, 2)
  currency        String                    @default("ETB")
  method          MembershipPaymentMethod
  status          MembershipPaymentStatus   @default(PENDING)
  bankName        String?                   // Bank name when method is MANUAL and payment type is transfer
  chapaTxRef      String?
  chapaRefId      String?
  receiptUrl      String?
  paidAt          DateTime?
  processedById   String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([chapaTxRef])
}

model MembershipCertificate {
  id              String                   @id @default(cuid())
  certificateId   String                   @unique // MAJ-YYYY-NNNN
  subscriptionId  String                   @unique
  subscription    MembershipSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pdfUrl          String?
  issuedAt        DateTime                 @default(now())
  expiresAt       DateTime
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([certificateId])
  @@index([memberId])
  @@index([expiresAt])
}
