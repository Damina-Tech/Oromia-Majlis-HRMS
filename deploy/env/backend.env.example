# Copy to /var/www/hrms/backend/.env on the VPS (chmod 600)
NODE_ENV=production
PORT=4000

# Database (match deploy/env/postgres.env)
DATABASE_URL="postgresql://hrms:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/majlis_hrms?schema=public"

# Redis (match deploy/env/postgres.env)
REDIS_URL="redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@127.0.0.1:6379"

# JWT — generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14

# Public URLs (use your domain or https://YOUR_VPS_IP)
# Same-origin via Nginx: set both to https://hrms.yourdomain.gov.et
CORS_ORIGIN=https://hrms.yourdomain.gov.et
APP_BASE_URL=https://hrms.yourdomain.gov.et
FRONTEND_URL=https://hrms.yourdomain.gov.et

# Behind Nginx reverse proxy (required for secure cookies + rate limits)
TRUST_PROXY=1

# Payment / integrations (fill as needed)
CHAPA_SECRET_KEY=
HALAL_AGREEMENT_TEMPLATE_URL=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Oromia Majlis HRMS

# SMS
SMS_ETHIOPIA_API_KEY=
SMS_ETHIOPIA_BASE_URL=https://smsethiopia.et/api

# Seed credentials (change immediately after first seed)
ADMIN_EMAIL=admin@oriasc.org
ADMIN_PASSWORD=ChangeMeAfterFirstLogin!
